# 将带 .html 的地址 301 重定向到无后缀的干净 URL
RewriteEngine On
RewriteBase /

# 根路径 301 跳转到中文首页（x-default），替代 meta refresh
RewriteRule ^$ /cn/ [R=301,L]
RewriteRule ^cn/index\.html$ /cn/ [R=301,L]
RewriteRule ^en/index\.html$ /en/ [R=301,L]
RewriteRule ^cn/about\.html$ /cn/about/ [R=301,L]
RewriteRule ^en/about\.html$ /en/about/ [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^about\.html$ /cn/about/ [R=301,L]

# ── 安全响应头(需 mod_headers;与 _headers / nginx 配置保持一致)──
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.binance.com https://www.deribit.com https://api.alternative.me; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>
